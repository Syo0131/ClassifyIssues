AUTH_SECRET=replace_with_a_64_char_random_secret
AUTH_SESSION_VERSION=1
AUTH_SESSION_MAX_AGE=28800
AUTH_URL=http://localhost:3000
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# Presupuesto de los tickets de tipo "desarrollo".
# El coste se deriva de las horas estimadas por la IA: cambiar la tarifa
# reajusta todos los presupuestos sin reanalizar los tickets.
# Tarifa por hora, en la divisa de DEV_CURRENCY (ajústala a tu mercado).
DEV_HOURLY_RATE=30
DEV_CURRENCY=USD
DEV_CONTINGENCY_PCT=15
# Locale de formato de importes. Por defecto es-DO (US$10,712, convención de
# República Dominicana). Cámbialo sólo si facturas a otro mercado.
# DEV_MONEY_LOCALE=es-DO

# Stack conocido de cada proyecto de cliente. Se inyecta en el prompt de
# desarrollo para que la arquitectura propuesta parta de lo que el cliente ya
# tiene. Al cliente NO se le pregunta por su stack: ya es cliente activo.
# Clave = nombre del proyecto (insensible a mayúsculas), valor = descripción.
DEV_PROJECT_STACKS={"resend":"Next.js 16 (App Router) + Postgres, desplegado en Vercel","web":"WordPress 6 + WooCommerce sobre PHP 8.2"}
# Usado para proyectos sin ficha propia en el mapa anterior.
DEV_DEFAULT_STACK=Next.js con Postgres, desplegado en contenedor Docker.

# PostgreSQL (recommended: use DATABASE_URL)
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/support_system

# PostgreSQL (alternative to DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGUSER=app_user
PGPASSWORD=app_password
PGDATABASE=support_system
PGSSL=false